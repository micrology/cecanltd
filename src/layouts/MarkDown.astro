---
import "../styles/style.css";

import consultancy from "../images/alvaro-reyes-qWwpHwip31M-unsplash.jpg";
import type { ImageMetadata } from "astro";
import Navigation from "../components/Navigation.astro";
import Head from "../components/Head.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";

const { title, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../images/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);
const heroPath = frontmatter?.heroImage as string | undefined;
const heroImage = heroPath
  ? images[heroPath]?.default
  : consultancy;
if (!heroImage) {
  throw new Error(`heroImage not found in src/images: ${heroPath}`);
}
const heroAlt = (frontmatter?.heroAlt as string | undefined) ?? "";
---
<style is:global>
h1, h2, h3 {
      font-size: 1.25rem;
      font-weight: 400;
      margin: 0 0 1rem 0;
    }
</style>
<html lang="en-GB">
  <Head />
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Navigation link="none" />

    <main id="main" class="main-content">
      <Hero
        image={heroImage}
        alt={heroAlt}
      >
        <p>
          CECAN Ltd is the commercial consultancy arm of the ESRC funded <a
            href="https://cecan.ac.uk"
            style="color:white"
            >Centre for the Evaluation of Complexity Across the Nexus</a
          > (CECAN). We offer access to innovative policy evaluation approaches and
          methods to support decision makers.
        </p>
      </Hero>
      <section class="page-header-card">
        <p class="page-title">{pageTitle}</p>
        <slot />
      </section>
    </main>

    <Footer />
  </body>
</html>
