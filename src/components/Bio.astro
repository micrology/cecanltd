---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  name: string;
  title: string;
}

const { image, name, title } = Astro.props;
const alt = `Portrait of ${name}, ${title}`;
---

<div class="bio">
  <button type="button" class="bio-card" data-bio-open>
    <Image src={image} alt={alt} width={240} height={270} />
    <span class="bio-name">{name}</span>
    <span class="bio-title">{title}</span>
  </button>

  <dialog class="bio-dialog" aria-label={title}>
    <Image src={image} alt={alt} width={448} />
    <span class="bio-name">{name}</span>
    <span class="bio-title">{title}</span>
    <div class="bio-text"><slot /></div>
  </dialog>
</div>

<style>
  .bio {
    display: inline-block;
  }

  .bio-card,
  .bio-dialog {
    background: #fff;
    border: 10px solid #fff;
    box-shadow: 6px 6px 18px 0px rgba(0, 0, 0, 0.3);
  }

  .bio-card {
    display: block;
    box-sizing: border-box;
    /* 240px content width plus the 10px border on each side */
    width: 260px;
    max-width: 100%;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: center;
    text-wrap: wrap;
    cursor: pointer;
  }
  .bio-name {
    display: block;
    margin: 0;
    padding: 0.5rem 0.25rem 0;
    font-weight: 600;
    font-size: 18px;
    text-align: center;
  }
  .bio-title {
    display: block;
    margin: 0;
    padding: 0.5rem 0.25rem 0;
    font-weight: 400;
    text-align: center;
  }
  .bio-dialog {
    padding: 0;
    width: min(28rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    color: inherit;
    cursor: pointer;
  }
  .bio-dialog img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 240 / 270;
  }
  .bio-text {
    padding: 0.75rem 0.75rem 0.5rem;
    text-align: left;
  }
  .bio-dialog > .bio-title {
    color: var(--text-muted);
  }
  .bio-dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }
</style>

<script>
  const margin = 16;

  document.querySelectorAll<HTMLElement>(".bio").forEach((bio) => {
    const card = bio.querySelector<HTMLElement>("[data-bio-open]")!;
    const dialog = bio.querySelector<HTMLDialogElement>("dialog")!;

    card.addEventListener("click", () => {
      const rect = card.getBoundingClientRect();
      dialog.style.inset = "auto";
      dialog.style.margin = "0";
      dialog.showModal();

      // Centre the dialog on the portrait, keeping it inside the viewport.
      const clamp = (value: number, size: number, max: number) =>
        Math.min(
          Math.max(value, margin),
          Math.max(margin, max - size - margin),
        );
      const place = () => {
        // offset sizes ignore the dialog's open transform, unlike getBoundingClientRect
        const width = dialog.offsetWidth;
        const height = dialog.offsetHeight;
        dialog.style.left = `${clamp(rect.left + rect.width / 2 - width / 2, width, window.innerWidth)}px`;
        dialog.style.top = `${clamp(rect.top + rect.height / 2 - height / 2, height, window.innerHeight)}px`;
      };

      // The dialog can grow after opening (image load, text layout), so re-place it on resize.
      const observer = new ResizeObserver(place);
      observer.observe(dialog);
      dialog.addEventListener("close", () => observer.disconnect(), {
        once: true,
      });
      place();
    });

    // Any click on the dialog or its backdrop dismisses it.
    dialog.addEventListener("click", () => dialog.close());
  });
</script>
