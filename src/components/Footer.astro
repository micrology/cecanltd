---

const year = new Date().getFullYear();
---

<style>
  /* Privacy notice (non-modal dialog) */
  .privacy-dialog {
    position: fixed;
    inset: auto auto 1.25rem 50%;
    transform: translateX(-50%);
    margin: 0;
    width: min(92vw, 34rem);
    max-width: calc(100vw - 2rem);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: 1rem 1.15rem;
    background: var(--accent-light);
    color: var(--text-main);
    z-index: 999;
  }

  .privacy-dialog:not([open]) {
    display: none;
  }

  .privacy-dialog[open] {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .privacy-dialog::backdrop {
    background: transparent;
  }

  .cookie-content {
    flex: 1;
    padding: 2px;
  }

  .cookie-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--primary-color);
    margin: 0 0 0.25rem;
  }

  .cookie-text {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.45;
  }

  .cookie-btn {
    background-color: var(--primary-color);
    color: #ffffff;
    border: none;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-sm);
    font-size: 0.825rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease;
    font: inherit;
  }

  .cookie-btn:hover {
    background-color: var(--accent-color);
  }

  @media (max-width: 600px) {
    .privacy-dialog[open] {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* Footer */
  .site-footer {
    background-color: var(--surface-color);
    border-top: 1px solid var(--border-color);
    padding: 0.5rem 1.25rem;
    margin-top: auto;
  }

  .footer-content {
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  .footer-text {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin: 0;
  }
</style>
<footer class="site-footer">
  <div class="footer-content">
    <p class="footer-text">
      CECAN Ltd is registered in England and Wales. Company registration number
      11489391 | VAT Number 307 9623 89 | &copy; {year} CECAN Ltd
    </p>
  </div>

  <dialog
    class="privacy-dialog"
    id="privacyDialog"
    aria-labelledby="privacyTitle"
  >
    <div class="cookie-content">
      <h2 class="cookie-title" id="privacyTitle">Privacy notice</h2>
      <p class="cookie-text">
        This site only uses storage that is required for basic functionality
        (for example, remembering this notice).
      </p>
    </div>
    <button type="button" class="cookie-btn" id="acceptCookiesBtn"
      >Got it</button
    >
  </dialog>
</footer>

<script>
  import "../scripts/cookie.js";
</script>
