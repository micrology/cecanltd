---
import logo from "../images/CECAN-Ltd-(web-use).png";
import Image from "astro/components/Image.astro";
const { link } = Astro.props;
---

<style>
  .site-header {
    background-color: var(--surface-color);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-sm);
    /* Positioning context for the absolute mobile menu panel. */
    /* sticky already establishes a containing block; keep explicit for clarity. */
  }
  .site-nav {
    display: contents;
  }
  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0.85rem 1.25rem;
    margin-inline: auto;
  }
  .site-nav {
    display: contents;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--primary-color);
    background-color: var(--accent-light);
  }

  .nav-link[aria-current="page"],
  .nav-link.active {
    color: var(--primary-color);
    background-color: var(--accent-light);
    font-weight: 600;
  }

  .mobile-nav-toggle {
    display: none;
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.65rem;
    cursor: pointer;
    color: var(--text-main);
    min-inline-size: 2.5rem;
    min-block-size: 2.5rem;
  }

  @media (max-width: 768px) {
    .mobile-nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
    }

    .nav-menu {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background-color: var(--surface-color);
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-4);
      gap: var(--space-2);
      border-bottom: 1px solid var(--border-color);
      box-shadow: var(--shadow-md);
    }

    .nav-menu.open {
      display: flex;
    }

    .nav-link {
      width: 100%;
      padding: 0.7rem 1rem;
    }
  }
</style>
<header class="site-header">
  <div class="nav-container">
    <a href="index.html">
      <Image
        src={logo}
        alt="CECAN Ltd logo"
        width="120"
        height="28"
        densities={[1, 2, 3]}
        loading="eager"
      />
    </a>
    <button
      type="button"
      class="mobile-nav-toggle"
      id="mobileNavToggle"
      aria-label="Open menu"
      aria-controls="navMenu"
      aria-expanded="false"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <nav class="site-nav" id="siteNav" aria-label="Primary">
      <ul class="nav-menu" id="navMenu">
        <li>
          <a
            href="index.html"
            class="nav-link"
            aria-current={link === "index" ? "page" : undefined}>Home</a
          >
        </li>
        <li>
          <a
            href="about.html"
            class="nav-link"
            aria-current={link === "about" ? "page" : undefined}>About</a
          >
        </li>
        <li>
          <a
            href="whatwedo.html"
            class="nav-link"
            aria-current={link === "whatwedo" ? "page" : undefined}
            >What we do</a
          >
        </li>
        <li>
          <a
            href="casestudies.html"
            class="nav-link"
            aria-current={link === "casestudies" ? "page" : undefined}
            >Case studies</a
          >
        </li>
        <li>
          <a
            href="contact.html"
            class="nav-link"
            aria-current={link === "contact" ? "page" : undefined}
            >Get in touch</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import "../scripts/mobile-nav.js";
</script>
