---
import Image from "astro/components/Image.astro";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt} = Astro.props;
---

<section class="hero-section" aria-label="Introduction">
  <div class="hero-image-wrapper">
    <Image
      src={image}
      alt={alt}
      class="hero-image"
      width="1200"
      height="674"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      layout="full-width"
    />
    <div class="hero-overlay">
      <h1 class="hero-title">Supporting decision-makers in a complex world</h1>
      <p class="hero-subtitle"><slot /></p>
    </div>
  </div>
</section>
