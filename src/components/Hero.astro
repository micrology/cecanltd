---
import Image from "astro/components/Image.astro";
import type { ImageMetadata } from "astro";

type Props = { alt: string } & (
  | { video: string; image?: ImageMetadata }
  | { video?: undefined; image: ImageMetadata }
);

const { image, alt, video } = Astro.props;
---

<section class="hero-section" aria-label="Introduction">
  <div class="hero-image-wrapper">
    {
      video ? (
        <video
          class="hero-image"
          src={video}
          preload="auto"
          poster={image?.src}
          aria-label={alt}
          autoplay
          muted
          playsinline
        >
          Your browser does not support the video tag.
        </video>
      ) : image ? (
        <Image
          src={image}
          alt={alt}
          class="hero-image"
          width="1200"
          height="674"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          layout="full-width"
        />
      ) : null
    }
    <div class="hero-overlay">
      <h1 class="hero-title">Supporting decision-makers in a complex world</h1>
      <p class="hero-subtitle"><slot /></p>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-6);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-color);
  }

  .hero-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1.75 / 1;
    max-height: 400px;
    overflow: hidden;
    background-color: #e2e8f0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-overlay {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    background: linear-gradient(
      to top,
      rgba(15, 23, 42, 0.85),
      rgba(15, 23, 42, 0.08)
    );
    color: #ffffff;
    padding: 1.75rem 1.5rem 1.25rem;
  }

  .hero-title {
    color: #ffffff;
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: 700;
    margin: 0 0 0.4rem;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
  }

  .hero-subtitle {
    color: #e2e8f0;
    font-size: 1rem;
    margin: 0;
    max-width: 46rem;
    line-height: 1.5;
  }
  @media (max-width: 768px) {
    .hero-subtitle {
      font-size: 0.7rem;
    }
  }
</style>
