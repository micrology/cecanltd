---
import "../styles/style.css";

import casestudies from "../images/claudio-schwarz-k39RGHmLoV8-unsplash.jpg";
import Navigation from "../components/Navigation.astro";
import Head from "../components/Head.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en-GB">
  <Head />
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Navigation link="contact" />

    <main id="main" class="main-content">
      <Hero image={casestudies} alt="A class in progress">
        <p>
          CECAN Ltd partners with clients across government, public agencies,
          and independent organizations to tackle high-stakes, complex social
          challenges.
        </p>
      </Hero>
      <section>
        <div class="grid-cols-1">
          <div class="info-card">
            <h1>Contact us</h1>
            <p>
              The best way to get in touch is by email: <a
                href="mailto:admin@cecan.co.uk">admin@cecan.co.uk</a
              >.
            </p>
            <p>
              Our postal address is:
              <blockquote>
                Chantries Retreat<br />
                Clifford Manor Road<br />
                Guildford, Surrey<br />
                GU4 8AG<br />
                United Kingdom
              </blockquote>
            </p>
            <p>
              You can also reach us by phone: <a href="tel:+44(0)7747555368"
                >+44 (0)7747 555368</a
              >.
              <p>CECAN Ltd is registered in England and Wales.</p>
              <p>Company registration number: 11489391.</p>
              <p>VAT Number: 307 9623 89</p>
            </p>
          </div>
        </div>
      </section>
      <Footer />
    </main>
  </body>
</html>
