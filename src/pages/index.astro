---
import "../styles/style.css";

import Image from "astro/components/Image.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Hero from "../components/Hero.astro";

import poster from "../images/engCountryPoster.webp";
import consultancy from "../images/alvaro-reyes-qWwpHwip31M-unsplash.jpg";
import mapping from "../images/PRSM screenshot version 2.4.2.png";
import training from "../images/sincerely-media-dGxOgeXAXm8-unsplash.jpg";
import examples from "../images/patrick-perkins-ETRPjvb0KM0-unsplash.jpg";
import bullet from "../images/bullet.png";
---

<style>
  .info-card h2 {
    margin: 0 0 0.5rem 0;
  }
  a {
    text-decoration-thickness: from-font;
  }
  a:hover {
    text-decoration-thickness: 2px;
  }
  .more {
    color: var(--accent-color);
    padding-left: 0.5rem;
    text-decoration: none;
  }
</style>
<html lang="en-GB">
  <Head />
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navigation link="index" />

    <main id="main" class="main-content">
      <!-- <Hero image={wrapped_earth} alt="A wrapped earth">-->
      <Hero
        video="16693048_640_360_24fps.mp4"
        alt="Overhead view of a country landscape"
        image={poster}
      >
        <p>
          We bring together systems thinking, flexible evaluation methods, and
          social science research to unlock practical insights, helping our
          partners improve policy, align teams, and make confident,
          evidence-based decisions.
        </p>
      </Hero>
      <section>
        <div class="grid-cols-2">
          <div class="info-card">
            <ul class="bullet-list" style={`--bullet: url(${bullet.src})`}>
              <li>
                Complex public policy challenges rarely have simple solutions.
                At CECAN Ltd, we help government departments, public bodies and
                partner organisations navigate complexity through innovative
                evaluation, systems thinking and evidence-informed
                decision-making.
              </li>
              <li>
                Our work combines academic expertise with practical application,
                supporting clients to understand how policies, programmes and
                organisations operate within complex systems.
              </li>
            </ul>
          </div>
          <div class="info-card">
            <ul class="bullet-list" style={`--bullet: url(${bullet.src})`}>
              <li>
                Complex public policy challenges rarely have simple solutions.
                At CECAN Ltd, we help government departments, public bodies and
                partner organisations navigate complexity through innovative
                evaluation, systems thinking and evidence-informed
                decision-making.
              </li>
              <li>
                Our work combines academic expertise with practical application,
                supporting clients to understand how policies, programmes and
                organisations operate within complex systems.
              </li>
            </ul>
          </div>
        </div>
      </section>
      <section>
        <div class="grid-cols-2">
          <div class="info-card">
            <a href="/whatwedo.html#consultancy"><h2>Consultancy</h2></a>
            <Image
              src={consultancy}
              alt="A person writing on a whiteboard"
              class="info-image"
              width="200"
              height="150"
            />
            <p>
              We offer expert consultancy services to help organisations
              navigate complex challenges and make informed decisions.
              <a href="/whatwedo.html#consultancy" class="more">More...</a>
            </p>
          </div>
          <div class="info-card">
            <a href="/casestudies.html"><h2>Expertise</h2></a>
            <Image
              src={examples}
              alt="A person holding a magnifying glass over a document"
              class="info-image"
              width="200"
              height="150"
            />
            <p>
              Our team has extensive experience in evaluation, research, and
              policy analysis, with a focus on complex social challenges.
              <a href="/casestudies.html" class="more">More...</a>
            </p>
          </div>
        </div>
        <div class="grid-cols-2">
          <div class="info-card">
            <a href="/whatwedo.html#training"><h2>Training</h2></a>
            <Image
              src={training}
              alt="A person giving a presentation to a group of people"
              class="info-image"
              width="200"
              height="150"
            />
            <p>
              We provide training and development opportunities to help
              organisations build their capacity and improve their performance.
              <a href="/whatwedo.html#training" class="more">More...</a>
            </p>
          </div>
          <div class="info-card">
            <a href="/psm.html"><h2>System mapping</h2></a>
            <Image
              src={mapping}
              alt="A screenshot of a participatory systems mapping diagram"
              class="info-image"
              width="200"
              height="150"
            />
            <p>
              We are pioneers in the application of Participatory Systems
              Mapping (PSM) to appraisal and evaluation.
              <a href="/psm.html" class="more">More...</a>
            </p>
          </div>
        </div>
      </section>
      <Footer />
    </main>
  </body>
</html>
